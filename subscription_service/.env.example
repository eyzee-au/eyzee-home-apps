# Generate unique keys using: python -m subscription_service.cli keys
# Never commit real secrets or the data directory.
EYZEE_DATA_DIR=/data
EYZEE_DATA_KEY=
EYZEE_SIGNING_KEY=
EYZEE_ADMIN_TOKEN=
EYZEE_SHOPIFY_SECRET=
# Actual myshopify.com domain, not the public retail domain.
EYZEE_SHOP_DOMAIN=
# Optional until read-only reconciliation is connected.
EYZEE_SHOPIFY_ACCESS_TOKEN=
# Replace numeric variant IDs after the products are created.
# activation: new code per unit; included: first year on activation;
# subscription: new code if no matching customer/plan, otherwise renewal;
# renewal: existing entitlement only, never creates a new installation.
# Multiple same-plan installations need _eyzee_entitlement_id on renewals.
EYZEE_VARIANTS={}
EYZEE_SMTP_HOST=
EYZEE_SMTP_PORT=587
EYZEE_SMTP_USER=
EYZEE_SMTP_PASSWORD=
EYZEE_EMAIL_FROM=
EYZEE_RENEWAL_URL_CORE=
EYZEE_RENEWAL_URL_HOME=
